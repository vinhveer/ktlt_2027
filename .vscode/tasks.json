{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: build",
            "type": "shell",
            "command": "mkdir -p build && echo '[build] Dang bien dich ${fileBasename} ...' && g++ -g -std=c++17 -Wall '${file}' -o 'build/${fileBasenameNoExtension}' && echo '[build] OK'",
            "windows": {
                "command": "(if not exist build mkdir build) && echo [build] Dang bien dich ${fileBasename} ... && g++ -g -std=c++17 -Wall \"${file}\" -o \"build\\${fileBasenameNoExtension}.exe\" && echo [build] OK",
                "options": {
                    "cwd": "${fileDirname}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/d",
                            "/c"
                        ]
                    }
                }
            },
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true,
                "echo": false,
                "showReuseMessage": false
            }
        },
        {
            "label": "C++: build & run",
            "type": "process",
            "command": "${fileDirname}/build/${fileBasenameNoExtension}",
            "windows": {
                "command": "${fileDirname}\\build\\${fileBasenameNoExtension}.exe"
            },
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "C++: build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true,
                "echo": false,
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "C++: build & run (cửa sổ ngoài)",
            "type": "process",
            "command": "osascript",
            "args": [
                "-e",
                "tell application \"Terminal\" to activate",
                "-e",
                "tell application \"Terminal\" to do script \"cd '${fileDirname}' && clear && ./build/'${fileBasenameNoExtension}'\""
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-Command",
                    "Start-Process cmd.exe -WorkingDirectory '${fileDirname}' -ArgumentList '/c chcp 65001 >nul & \"build\\${fileBasenameNoExtension}.exe\" & echo. & pause'"
                ]
            },
            "linux": {
                "command": "x-terminal-emulator",
                "args": [
                    "-e",
                    "bash",
                    "-c",
                    "cd '${fileDirname}' && './build/${fileBasenameNoExtension}'; echo; read -n 1 -s -p 'Nhan phim bat ky de dong...'"
                ]
            },
            "dependsOn": "C++: build",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "never"
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\Users\\Admin\\AppData\\Local/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-Wall"
            ],
            "options": {
                "cwd": "C:\\Users\\Admin\\AppData\\Local/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
